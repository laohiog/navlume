{
  "name": "navlume",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Lightweight, self-hosted, brandable URL navigation platform.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server-build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "backup": "tsx src/server/backup.ts",
    "restore": "tsx src/server/restore.ts",
    "admin:create": "tsx src/server/bootstrap-admin.ts",
    "migrate:prod": "node dist/server/db/migrate.js",
    "backup:prod": "node dist/server/server/backup.js",
    "restore:prod": "node dist/server/server/restore.js",
    "admin:create:prod": "node dist/server/server/bootstrap-admin.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@hono/node-server": "^2.1.1",
    "better-auth": "1.7.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "better-auth": {
      "better-sqlite3": "$better-sqlite3"
    }
  }
}

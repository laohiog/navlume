# ---------------------------------------------------------------------------
# Environment configuration
#
# Local development reads this file (or real environment variables) directly.
# Docker deployments do NOT use this file: `compose.yml` passes the same values
# to the container explicitly. See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# `development` or `production`.
#
# In `production`, BETTER_AUTH_SECRET and BETTER_AUTH_URL become required and the
# server refuses to start without them. Docker sets this to `production`.
NODE_ENV=development

# Interface and port the Hono server binds to.
#
# Docker binds 0.0.0.0:3000 so the published port is reachable. Local
# development can leave these unset (defaults: 0.0.0.0 and 3000).
HOST=0.0.0.0
PORT=3000

# ---------------------------------------------------------------------------
# Persistent data
# ---------------------------------------------------------------------------

# SQLite database file. Docker maps this onto the persistent volume.
DATABASE_PATH=

# Uploaded brand assets. Must NOT be a directory that contains DATABASE_PATH —
# restore writes temporary database recovery files beside the database, so the
# database must not live inside the uploads tree.
#
#   safe:   DATABASE_PATH=/data/nav.sqlite   UPLOADS_DIR=/data/uploads
#   unsafe: DATABASE_PATH=/data/uploads/nav.sqlite
UPLOADS_DIR=

# Backup destination root for `npm run backup`. Docker operators normally pass an
# explicit path inside the volume (see docs/DEPLOYMENT.md).
BACKUP_DIR=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Signing secret. Generate with: openssl rand -base64 32
#
# Required in production. Never commit a real value. In development an insecure
# fallback is used and a warning is printed.
BETTER_AUTH_SECRET=

# Public base URL of the deployment.
#
# This must be the origin the BROWSER uses, because Better Auth validates the
# request Origin (CSRF protection) against it. Cookies are only sent on requests
# whose Origin is trusted.
#
# Production (single container, same origin): the public site URL.
#   BETTER_AUTH_URL=https://nav.example.com
#
# Local development: the Vite dev server origin, not the Hono port, because the
# browser loads the app from Vite and proxies /api to Hono.
#   BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# First administrator bootstrap (one-shot)
# ---------------------------------------------------------------------------
#
# A fresh deployment has no administrator, and public sign-up is disabled. After
# the first start, create the initial administrator once:
#
#   docker compose run --rm \
#     -e BOOTSTRAP_ADMIN_USERNAME=admin \
#     -e BOOTSTRAP_ADMIN_EMAIL=admin@example.com \
#     -e BOOTSTRAP_ADMIN_PASSWORD='<strong password>' \
#     -e BOOTSTRAP_ADMIN_NAME='Administrator' \
#     app node dist/server/server/bootstrap-admin.js
#
# Or locally: npm run admin:create
#
# These are ONE-SHOT variables. Do NOT add them to compose.yml or any long-lived
# environment file, because the password would then persist as deployment state.
# The command refuses to run when an administrator already exists, and never logs
# the password.
#
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=

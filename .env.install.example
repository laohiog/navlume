# Copy to .env beside compose.install.yml. Never share or commit the filled file.
# Navlume v0.1.3 approved release preparation; Tag/Release not yet published.
# Verified Linux AMD64 runtime source: 361aaa6439ba16e3579d097629ac75fe2df4fc91.
# Release documentation commit: see RELEASE-IDENTITY.json; image source is unchanged.
NAV_IMAGE=ghcr.io/laohiog/navlume@sha256:81081c094488af19bda6fa1d0b37a582c76053084ce9410d358f15efe70af857

# Generate locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# localhost trial only; NAS/LAN/production access requires an HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000

# Defaults are safe for a reverse proxy on the same host or a localhost trial.
# For a proxy on another host, bind explicitly to the server's private LAN IP.
NAV_BIND_IP=127.0.0.1
NAV_PORT=3000

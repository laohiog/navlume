# Copy to .env beside compose.install.yml. Never share or commit the filled file.
# Replace with the publisher's sha-<full-reviewed-commit> tag or @sha256:<digest>.
# This template is not a claim that an image has already been published.
NAV_IMAGE=ghcr.io/laohiog/navlume:sha-<full-reviewed-public-commit>

# Generate locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# localhost trial only; NAS/LAN/production access requires an HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000

# Defaults are safe for a reverse proxy on the same host or a localhost trial.
# For a proxy on another host, bind explicitly to the server's private LAN IP.
NAV_BIND_IP=127.0.0.1
NAV_PORT=3000
